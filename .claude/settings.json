{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(docker compose:*)",
      "Bash(docker:*)",
      "Bash(bun test *)",
      "Bash(bun run *)",
      "Bash(bunx tsc --noEmit)",
      "Bash(curl -s http://localhost:4760/api/health)",
      "Bash(curl -s http://localhost:4760/*)",
      "Bash(curl:*)",
      "Bash(git branch:*)",
      "Bash(git merge:*)",
      "Bash(op read:*)",
      "Bash(op run *)",
      "Bash(git fetch *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/unrestricted-bash-guard.sh",
            "timeout": 30,
            "statusMessage": "Checking command against unrestricted-mode policy…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/lazy-stop-watcher.sh",
            "timeout": 30,
            "statusMessage": "Checking turn for lazy bail-out…"
          }
        ]
      }
    ]
  }
}
